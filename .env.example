# Copy to .env and edit. Glob patterns supported (fnmatch).
# Format: pattern:Display Name (or just pattern), comma-separated.
SERVICES=ntfy:Notifications, forgejo:Forgejo, immich_server:Immich, my-app-*:My App, beacon:Beacon
# External URLs to probe: url:Display Name, comma-separated.
ENDPOINTS=https://example.com:Website, https://git.example.com:Git
